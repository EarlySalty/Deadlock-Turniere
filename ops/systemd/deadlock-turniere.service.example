# Vorlage für eine systemd-User-Unit. Installationspfade bewusst anpassen.
# Globale Betriebswerte stehen in config/bot.toml. Kein EnvironmentFile für sie.
# Den bereits eingerichteten geschützten Infisical-Bootstrap weiterverwenden.
# Sein vorhandenes LoadCredential-Drop-in gehört nicht in diese Vorlage.
[Unit]
Description=Deadlock Turniere Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/deadlock-turniere
ExecStart=/opt/deadlock-turniere/scripts/run_turniere_backend_rust.sh --config /opt/deadlock-turniere/config/bot.toml
# Änderungen werden vor einem geordneten Neustart separat geprüft:
# /opt/deadlock-turniere/scripts/run_turniere_backend_rust.sh --config /opt/deadlock-turniere/config/bot.toml --check-config
# Kein ExecReload: Clients, Listener und Scheduler werden beim Neustart aufgebaut.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
